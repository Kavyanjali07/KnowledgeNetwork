# KnowledgeNetwork Production & Local Environment Variables Template
# NEVER commit real credentials or secrets to version control.

# Active Spring Profile (dev, local, prod)
SPRING_PROFILES_ACTIVE=prod

# Server Port
SERVER_PORT=8080

# Database Configuration (PostgreSQL 16)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-host:5432/knowledgenetwork_db
SPRING_DATASOURCE_USERNAME=kn_admin
SPRING_DATASOURCE_PASSWORD=replace_with_strong_production_db_password

# Database Connection Pool (HikariCP)
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5
SPRING_FLYWAY_ENABLED=true

# JWT Security Configuration (REQUIRED: Minimum 64 hex characters)
APP_JWT_SECRET=replace_with_a_64_character_hexadecimal_random_secret_string
APP_JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
APP_JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
APP_JWT_ISSUER=knowledgenetwork-api

# Cookie & CORS Security
APP_COOKIE_SECURE=true
APP_CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
APP_CORS_INCLUDE_LOCAL_ORIGINS=false

# SMTP Mail Credentials (Gmail or Custom SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
MAIL_USERNAME=your-app-email@domain.com
MAIL_PASSWORD=your-google-app-password

# Rate Limiting Configuration
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Monitoring / Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password
